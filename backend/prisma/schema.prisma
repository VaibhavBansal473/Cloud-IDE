generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String
  submissions Submission[]
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String
}

model Problem {
  id               String        @id @default(uuid())
  name             String
  level            Difficulty
  tags             String[]

  visible          Boolean       @default(true)
  adminId          String

  problemStatement String        @db.Text

  sampleInput      String        @db.Text
  sampleOutput     String        @db.Text

  testCases        TestCase[]

  submissions      Submission[]
}

model TestCase {
  id        String   @id @default(uuid())

  input     String   @db.Text
  output    String   @db.Text

  hidden    Boolean  @default(true)
  position  Int      @default(0)

  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Submission {
  id                String    @id @default(uuid())

  userId            String
  problemId         String

  state             String

  judge0TrackingId  String    @unique
  judge0Tokens      String[]  @default([])
  currentBatchStart Int       @default(0)
  failedTestCase    Int?
  verdictMessage    String    @default("")
  sourceCode        String    @default("") @db.Text
  languageId        Int       @default(0)

  time              String    @default("")
  memory            Int       @default(0)
  stdout            String    @default("")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id])
  problem           Problem   @relation(fields: [problemId], references: [id])
}
